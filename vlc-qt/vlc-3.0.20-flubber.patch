      * Load DLLs from system32 before any other folder (when possible)
      */
     PrioritizeSystem32();
+    if (!PreloadFlubberQt())
+    {
+        MessageBoxW(NULL, L"Flubber VLC could not load its Qt runtime.",
+                    L"Flubber VLC", MB_OK | MB_ICONERROR);
+        return 1;
+    }
 
     /* Args */
     wchar_t **wargv = CommandLineToArgvW (GetCommandLine (), &argc);
